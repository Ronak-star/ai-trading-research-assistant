# Database
# For local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_research
# For quick local demo without installing Postgres (SQLite fallback):
DATABASE_URL=sqlite:///./trading_research.db

# AI provider: "openai" or "mock" (mock = deterministic rule-based fallback, no API key needed)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# CORS
FRONTEND_ORIGIN=http://localhost:3000
